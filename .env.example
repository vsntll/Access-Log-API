PORT=3000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/access_log

# Auth0 API settings (Application > APIs in the Auth0 dashboard)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://access-log-api

# Only needed for the Playwright test that requests a token via
# client-credentials grant (Applications > Machine to Machine)
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
