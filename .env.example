PORT=3000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/access_log

# Auth0 API settings (Application > APIs in the Auth0 dashboard)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://access-log-api

# Only needed for the Playwright tests that request a token via the
# client-credentials grant (Applications > Machine to Machine). That
# application must be granted the write:events and write:doors
# permissions on the API above (see README "Enable scopes in Auth0").
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
